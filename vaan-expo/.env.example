# ---------------------------------------------------------------------------
# Vaan Consulting - Expo environment template
# Copy to `.env` (git-ignored) and fill in real values locally, or configure
# these as EAS secrets for CI builds:  eas secret:create --name GEMINI_API_KEY ...
# ---------------------------------------------------------------------------

# OPTION A (recommended, production): point the app at a server-side proxy that
# holds the Gemini key. Nothing secret ends up inside the mobile bundle.
# The proxy must expose POST { prompt, systemInstruction?, history?, temperature? }
# and return { text: string }.
VAAN_AI_PROXY_URL=

# OPTION B (development only): embed a Gemini API key in the client bundle.
# WARNING: anything in `extra` is readable by anyone who unpacks the app binary.
# Use a key restricted to the Generative Language API with tight quotas.
GEMINI_API_KEY=

# Formspree endpoint used for inquiry / booking notifications.
VAAN_FORMSPREE_ENDPOINT=https://formspree.io/f/mvzjrrjj

# EAS project id (optional, only needed for EAS Build / Update).
EAS_PROJECT_ID=
